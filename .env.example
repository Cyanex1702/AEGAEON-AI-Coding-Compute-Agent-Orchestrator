# Controller
AEGAEON_HOST=127.0.0.1
AEGAEON_PORT=8000
AEGAEON_DATABASE_URL=sqlite:///./data/aegaeon.db
AEGAEON_DATA_DIR=./data
AEGAEON_WORKER_TOKEN=development-token
AEGAEON_DEMO_MODE=true
AEGAEON_HEARTBEAT_TIMEOUT_SECONDS=20
AEGAEON_JOB_LEASE_SECONDS=30
AEGAEON_JOB_ASSIGNMENT_TIMEOUT_SECONDS=180
AEGAEON_MAX_RETRIES=3
AEGAEON_PAIRING_CODE_LIFETIME_SECONDS=1800
HF_TOKEN=

# Generic OpenAI-compatible provider (optional in demo mode)
AEGAEON_LLM_BASE_URL=http://localhost:11434/v1
AEGAEON_LLM_API_KEY=
AEGAEON_LLM_MODEL=code-model
AEGAEON_LLM_TIMEOUT_SECONDS=180
AEGAEON_LLM_MAX_OUTPUT_TOKENS=16384
AEGAEON_LLM_STRUCTURED_OUTPUT_MODE=auto
AEGAEON_LLM_OUTPUT_RETRIES=2
AEGAEON_LLM_CONTEXT_CHARACTERS=60000

# Web UI (apps/web/.env.local)
NEXT_PUBLIC_AEGAEON_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AEGAEON_WS_URL=ws://127.0.0.1:8000

